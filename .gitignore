# 构建输出：不提交；使用源码和 sdkconfig.defaults 重新生成。
/build/
/build-*/
/dist/
/managed_components/

# 本机配置及凭据：不提交；sdkconfig.defaults、示例配置正常提交。
/sdkconfig
/sdkconfig.old
/main/bambu/config.local.h

# 开发依赖、缓存和日志：不提交。
node_modules/
__pycache__/
*.pyc
*.log

# 字体临时工作副本：归档源在 docs/assets/fonts/source，正常提交。
/tools/fonts/*.ttf

# docs中的设计、素材源、真机反馈及精选预览正常提交。
# 批量帧输出至build，历史归档放在backups。

# 完整私有备份：可能含本地配置；保留本地，不提交。
/backups/
