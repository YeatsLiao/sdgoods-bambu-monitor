# 构建输出：不提交；使用源码和 sdkconfig.defaults 重新生成。
/build/
/build-*/
/dist/
/managed_components/

# 本机配置及凭据：不提交；sdkconfig.defaults、示例配置正常提交。
/sdkconfig
/sdkconfig.old
/main/bambu/config.local.h

# 开发依赖、缓存和日志：不提交。
node_modules/
__pycache__/
*.pyc
*.log

# 字体临时工作副本：归档源在 docs/assets/fonts/source，正常提交。
/tools/fonts/*.ttf

# 可生成的批量预览、历史渲染帧：本地保留，完整备份覆盖。
# 不忽略 docs/design、docs/assets、docs/verification/device 和其余历史资料。
/docs/verification/preview/
/docs/history/releases/

# 完整私有备份：可能含本地配置；保留本地，不提交。
/backups/
